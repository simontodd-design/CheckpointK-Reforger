# ════════════════════════════════════════════════════════════════════════
# Checkpoint K — environment variable template
# ════════════════════════════════════════════════════════════════════════
# Copy to .env.local at the repo root and fill in real values.
# .env.local is gitignored.
# Production secrets live on the prod box at C:\ProgramData\CheckpointK\.env
# and come from GitHub Secrets via the deploy workflow.

# ──── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
CK_CORE_PORT=3001
CK_CORE_PUBLIC_URL=http://localhost:3001

# ──── Database (native Windows PostgreSQL 18) ───────────────────────────
DATABASE_URL=postgres://ck:ck_dev_password@localhost:5432/ck_dev

# ──── Redis / Memurai (native Windows) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──── Auth ──────────────────────────────────────────────────────────────
# Generate via PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=replace_me_with_random_48_char_secret
HMAC_SHARED_SECRET=replace_me_with_random_48_char_hex

# ──── Steam ─────────────────────────────────────────────────────────────
# From https://steamcommunity.com/dev/apikey
# DEV key — rotate before production. NEVER commit a real key.
STEAM_API_KEY=
STEAM_OPENID_REALM=http://localhost:3001
STEAM_OPENID_RETURN_URL=http://localhost:3001/auth/steam/callback

# ──── Discord ───────────────────────────────────────────────────────────
# Create app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Webhook URL for #ck-alerts channel. Critical errors get pushed here.
# This replaces a paid error-tracking service for v1.
DISCORD_ALERT_WEBHOOK_URL=

# ──── Logging (Pino) ────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# ──── mod.io ────────────────────────────────────────────────────────────
MODIO_API_KEY=
MODIO_GAME_ID=
CK_MOD_ID=

# ──── Cloudflare R2 (launcher binaries, voice clips, backups) ──────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_LAUNCHER=
R2_BUCKET_VOICE=
R2_BUCKET_BACKUPS=

# ──── Stripe (Phase 7+) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ──── ElevenLabs (Phase 10) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ──── Email (Resend recommended; transactional only) ───────────────────
RESEND_API_KEY=
EMAIL_FROM="Checkpoint K <noreply@checkpointk.com>"

# ──── Tauri updater signing (Phase 1) ──────────────────────────────────
# Generated via: bun tauri signer generate -w ~/.tauri/checkpointk.key
# Private key lives ONLY in GitHub Secrets as TAURI_SIGNING_PRIVATE_KEY
# Public key gets compiled into the launcher binary at build time
TAURI_PUBLIC_KEY=

# ──── Manager agent (one per host) ──────────────────────────────────────
CORE_WS_URL=ws://localhost:3001/agents
AGENT_TOKEN=replace_me_per_host_token
AGENT_HOST_ID=local-dev

# ──── Production-only (do not set locally) ──────────────────────────────
# Set in C:\ProgramData\CheckpointK\.env on prod box
# CK_CORE_PUBLIC_URL=https://core.checkpointk.com
# CK_CORE_PORT=3000
# STEAM_OPENID_REALM=https://core.checkpointk.com
# STEAM_OPENID_RETURN_URL=https://core.checkpointk.com/auth/steam/callback
# DISCORD_REDIRECT_URI=https://core.checkpointk.com/auth/discord/callback
