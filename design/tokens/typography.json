{
  "_meta": {
    "version": "0.0.1-placeholder",
    "notes": "Placeholder typography. Finalize fonts in the Phase 0 freelance designer sprint. Recommended: a slab-serif or stencil display, a clean humanist sans for body, and a technical mono for readouts."
  },
  "fontFamily": {
    "display": "'CK Display', 'Spectral SC', 'Cinzel', Georgia, serif",
    "body":    "'CK Body', 'Inter', system-ui, sans-serif",
    "mono":    "'CK Mono', 'JetBrains Mono', 'Cascadia Code', monospace"
  },
  "fontWeight": {
    "regular": 400,
    "medium":  500,
    "semibold": 600,
    "bold":    700
  },
  "fontSize": {
    "xs":      "11px",
    "sm":      "13px",
    "base":    "15px",
    "md":      "17px",
    "lg":      "20px",
    "xl":      "24px",
    "2xl":     "32px",
    "3xl":     "44px",
    "4xl":     "60px"
  },
  "lineHeight": {
    "tight":   1.15,
    "snug":    1.3,
    "normal":  1.5,
    "relaxed": 1.7
  },
  "letterSpacing": {
    "tight":   "-0.01em",
    "normal":  "0",
    "wide":    "0.04em",
    "widest":  "0.12em"
  },
  "scale": {
    "displayHero":   { "family": "display", "size": "4xl", "weight": "semibold", "leading": "tight",  "tracking": "tight"  },
    "displayLarge":  { "family": "display", "size": "3xl", "weight": "semibold", "leading": "tight",  "tracking": "normal" },
    "displayMedium": { "family": "display", "size": "2xl", "weight": "semibold", "leading": "snug",   "tracking": "normal" },
    "headingLarge":  { "family": "body",    "size": "xl",  "weight": "semibold", "leading": "snug",   "tracking": "normal" },
    "headingMedium": { "family": "body",    "size": "lg",  "weight": "semibold", "leading": "snug",   "tracking": "normal" },
    "headingSmall":  { "family": "body",    "size": "md",  "weight": "medium",   "leading": "normal", "tracking": "normal" },
    "bodyLarge":     { "family": "body",    "size": "base","weight": "regular",  "leading": "normal", "tracking": "normal" },
    "bodyMedium":    { "family": "body",    "size": "sm",  "weight": "regular",  "leading": "normal", "tracking": "normal" },
    "bodySmall":     { "family": "body",    "size": "xs",  "weight": "regular",  "leading": "normal", "tracking": "wide"   },
    "label":         { "family": "body",    "size": "xs",  "weight": "semibold", "leading": "tight",  "tracking": "widest" },
    "mono":          { "family": "mono",    "size": "sm",  "weight": "regular",  "leading": "normal", "tracking": "normal" }
  }
}
