{
  "name": "@ck/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "CK Core — backend API, WebSocket gateway, jobs, admin",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/websockets": "^11.1.24",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/swagger": "^7.4.0",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.0",
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "pino-roll": "^2.0.0",
    "zod": "^3.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^22.5.0",
    "drizzle-kit": "^0.24.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "testcontainers": "^10.13.0",
    "typescript": "^5.5.0"
  }
}
