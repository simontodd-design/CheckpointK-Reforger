{
  "name": "checkpointk-reforger",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Checkpoint K — Arma Reforger build (monorepo)",
  "license": "MIT",
  "author": "Simon Todd <simontodd.design@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simontodd-design/CheckpointK-Reforger.git"
  },
  "workspaces": [
    "core",
    "manager",
    "manager-agent",
    "launcher"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:migrate": "bun run --filter @ck/core db:migrate",
    "db:studio": "bun run --filter @ck/core db:studio",
    "design:sync": "bun design/scripts/sync-mod-tokens.ts",
    "design:check": "bun design/scripts/sync-mod-tokens.ts --dry-run --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  }
}
